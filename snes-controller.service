# Adjust User/Group and the /home/<user> paths to match your install.
[Unit]
Description=SNES Controller -> MQTT + ADB reader
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/home/pi/.env
ExecStart=/home/pi/snes_read
Restart=always
RestartSec=5
User=pi
Group=pi
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
