# Copy this file to .env and fill in your own values.
# .env is gitignored and never committed.

# --- MQTT broker (Mosquitto, Home Assistant, Zigbee2MQTT, etc.) ---
MQTT_HOST=192.0.2.10
MQTT_PORT=1883
MQTT_USER=your_mqtt_user
MQTT_PASS=your_mqtt_password

# --- Tasmota smart-plug command topics: cmnd/<device>/POWER ---
MQTT_TOPIC_LIGHT1=cmnd/your_device_1/POWER
MQTT_TOPIC_LIGHT2=cmnd/your_device_2/POWER

# --- Android TV ADB endpoint (enable Network Debugging on the TV) ---
ADB_TV_IP=192.0.2.20
ADB_TV_PORT=5555
